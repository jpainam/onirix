{
  "name": "@onirix/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "node --import tsx --import varlock/auto-load src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node --import tsx --import varlock/auto-load src/migrate.ts",
    "db:encrypt-secrets": "node --import tsx --import varlock/auto-load src/encrypt-secrets.ts"
  },
  "dependencies": {
    "@onirix/connectors": "workspace:*",
    "@onirix/llm": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@onirix/config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.1",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  }
}
