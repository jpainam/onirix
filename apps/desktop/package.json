{
  "name": "desktop",
  "productName": "Onirix",
  "version": "0.1.0",
  "private": true,
  "description": "Onirix desktop client",
  "author": "Logesta Labs <contact@logestalabs.com>",
  "homepage": "https://github.com/jpainam/onirix",
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "node scripts/bundle.mjs && electron .",
    "check-types": "tsc --noEmit",
    "icon": "node scripts/icon.mjs",
    "pack": "node scripts/bundle.mjs && electron-builder --dir",
    "dist": "node scripts/bundle.mjs && electron-builder --publish never",
    "release": "node scripts/bundle.mjs && electron-builder --publish always"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@onirix/config": "workspace:*",
    "@onirix/ingestion": "workspace:*",
    "@onirix/llm": "workspace:*",
    "@onirix/ui": "workspace:*",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ai": "catalog:",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.34.5",
    "streamdown": "^2.6.0",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
