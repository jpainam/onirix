# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Where the product (apps/dashboard) is served. "Sign in" and "Create a
# workspace" on the public site link here; this site has no session of its own.
# @type=url
APP_URL=http://localhost:3001

# === Desktop app ===
# Where the download page finds the installers: a base URL that serves
# Onirix-mac-arm64.dmg, Onirix-mac-x64.dmg, Onirix-win-x64.exe and
# Onirix-linux-x64.AppImage. The default is this repository's latest GitHub
# release, which is where apps/desktop publishes. The page checks the files exist and says
# "coming soon" rather than linking to a 404 when they do not.
# @type=url
DESKTOP_DOWNLOAD_URL=https://github.com/jpainam/onirix/releases/latest/download
