# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=
# Encrypts workspace credentials at rest: model provider API keys and connected
# database URLs. 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# Losing it loses every stored credential; the web and worker must share one.
# @type=string(minLength=43)
SECRETS_ENCRYPTION_KEY=


# === OpenSearch: hybrid vector + keyword document index ===

# @type=string(minLength=1) @sensitive=false
OPENSEARCH_HOST=localhost

# @type=number @sensitive=false
OPENSEARCH_REST_API_PORT=9200

# @type=string(minLength=1) @sensitive=false
OPENSEARCH_ADMIN_USERNAME=admin

# @type=string(minLength=1)
OPENSEARCH_ADMIN_PASSWORD=

# @type=boolean @sensitive=false
OPENSEARCH_USE_SSL=true

# Self-signed cert by default; set true only with a real CA bundle.
# @type=boolean @sensitive=false
OPENSEARCH_VERIFY_CERTS=false

# === Redis: background indexing queue ===

# @type=string(minLength=1)
REDIS_URL=redis://localhost:6379

# === Object storage for uploaded originals (MinIO by default) ===

# @type=string(minLength=1) @sensitive=false
S3_ENDPOINT=http://localhost:9000

# @type=string(minLength=1)
S3_ACCESS_KEY_ID=

# @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=

# @type=string(minLength=1) @sensitive=false
S3_BUCKET=onirix-file-store

# === Google OAuth (optional social sign-in) ===
# When both are set, "Continue with Google" appears on the login page and the
# Google identity links into an existing verified account with the same email.

# @required=false @sensitive=false
GOOGLE_CLIENT_ID=

# @required=false
GOOGLE_CLIENT_SECRET=

# === Transactional email (Retransmit) ===
# Required: magic link, email verification, and password reset all send mail.

# @type=string(startsWith=rt_)
RETRANSMIT_API_KEY=

# Must be an address on a domain verified in Retransmit.
# @type=string(minLength=1) @sensitive=false
EMAIL_FROM=Onirix <contact@logestalabs.com>
