# Copy to apps/web/.env. Both values have working defaults in .env.schema, so
# this file is only needed when the defaults are wrong for you.

# Where the dashboard runs. Sign-in links on the public site point here.
APP_URL=http://localhost:3001

# Base URL that serves the desktop installers.
DESKTOP_DOWNLOAD_URL=https://github.com/jpainam/onirix/releases/latest/download
