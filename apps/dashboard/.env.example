# Copy to apps/dashboard/.env and fill in the four values marked REQUIRED.
# The dashboard and the worker both read this file. Rules are in .env.schema.

# === REQUIRED ===

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# openssl rand -base64 32
# Encrypts stored model API keys and database credentials. Losing it loses them.
SECRETS_ENCRYPTION_KEY=

# https://retransmit.dev. Sign-up verification and password reset send email.
RETRANSMIT_API_KEY=

# Must be an address on a domain verified in Retransmit.
EMAIL_FROM=Onirix <no-reply@your-domain.com>

# === Local defaults, matching docker-compose.yml ===
# Inside Docker, compose replaces the hosts below with the service names.
# As written they are right for running the apps on the host (pnpm run dev:dashboard).

BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5433/onirix
OPENSEARCH_HOST=localhost
OPENSEARCH_REST_API_PORT=9200
OPENSEARCH_ADMIN_USERNAME=admin
OPENSEARCH_ADMIN_PASSWORD=StrongPassword123!
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=onirix-file-store

# === Optional ===

# Both set: "Continue with Google" appears on the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Renders JavaScript-heavy websites before reading them. Spends Firecrawl credits.
FIRECRAWL_API_KEY=

# true lets website sources read private and loopback addresses (intranets).
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
